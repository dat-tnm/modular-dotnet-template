<UserControl x:Class="CompanyName.ProjectName.Hosts.WPF.ViewModels.Common.Sample.SampleSubMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CompanyName.ProjectName.Hosts.WPF.ViewModels.Common.Sample"
             xmlns:controls="clr-namespace:CompanyName.ProjectName.Hosts.WPF.Controls"

             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource BackgroundBrush}">
    
    <Grid>
        <!-- Loading Overlay -->
        <controls:LoadingOverlay Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" 
                                 Panel.ZIndex="999"/>
        
        <!-- Main Content -->
        <Grid IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Navigation Bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/> <!-- Left Panel 60% -->
                <ColumnDefinition Width="2*"/> <!-- Right Panel 40% -->
            </Grid.ColumnDefinitions>

            <controls:NavigationBar Grid.Row="0" Grid.ColumnSpan="2"/>

            <!-- LEFT PANEL -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                    Margin="10" CornerRadius="8" Padding="20"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Search -->
                        <RowDefinition Height="Auto"/> <!-- New Button -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Pagination -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="🔒 Job\Part BPM" 
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="On-Hold: Job\PartNum &amp; OpCode" 
                                   FontSize="14" 
                                   Foreground="{StaticResource OnSurfaceSecondaryBrush}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Search Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Keyword -->
                        <TextBox Grid.Column="0" 
                                 Text="{Binding SearchFilter.SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 FontSize="14"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="🔍 Search keyword..." 
                                                                       Foreground="{StaticResource OnSurfaceTertiaryBrush}"
                                                                       FontSize="14" Margin="5,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Search Button -->
                        <Button Grid.Column="2"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="15,8"
                                MinWidth="100">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Search" FontSize="14"/>
                            </StackPanel>
                        </Button>

                    </Grid>

                    <!-- New Button -->
                    <Button Grid.Row="2" 
                            Command="{Binding CreateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,0,5,0"/>
                            <TextBlock Text="New" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="3" 
                              ItemsSource="{Binding ItemsView}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="40"
                              BorderThickness="1"
                              BorderBrush="{StaticResource BorderBrush}">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Row" Binding="{Binding RowId}" Width="45"/>
                            <DataGridTextColumn Header="Job #" Binding="{Binding Jobnum}" Width="120"/>
                            <DataGridTextColumn Header="OpCode" Binding="{Binding OpCode}" Width="80"/>
                            <DataGridTextColumn Header="AlertMessage" Binding="{Binding AlertMessage}" Width="*"/>
                            
                            <!-- Status Column -->
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,5,5,0"/>
                                            <ComboBox SelectedValue="{Binding DataContext.StatusFilter, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedValuePath="Tag"
                                                      Padding="5,3"
                                                      FontSize="12"
                                                      Height="20"
                                                      BorderBrush="{StaticResource BorderBrush}">
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Padding" Value="8,3"/>
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                                <ComboBoxItem Content="All" Tag="{x:Null}" IsSelected="True"/>
                                                <ComboBoxItem Content="Active" Tag="True"/>
                                                <ComboBoxItem Content="Inactive" Tag="False"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                      Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Active"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Inactive"/>
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions Column -->
                            <DataGridTemplateColumn Header="Actions" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- Edit Button -->
                                            <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,4"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Edit">
                                                <TextBlock Text="✏️" FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <Border Grid.Row="4" 
                            Background="{StaticResource BackgroundBrush}"
                            Padding="15,10"
                            Margin="0,10,0,0"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Info Text -->
                            <TextBlock Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource OnSurfaceSecondaryBrush}">
                                <Run Text="Showing"/>
                                <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                                <Run Text="of"/>
                                <Run Text="{Binding TotalItems, Mode=OneWay}"/>
                                <Run Text="items"/>
                            </TextBlock>

                            <!-- Pagination Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="&lt;" 
                                        Command="{Binding PreviousPageCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        MinWidth="40"
                                        Margin="0,0,5,0"/>

                                <TextBlock Text="{Binding CurrentPage}" 
                                           VerticalAlignment="Center"
                                           Margin="10,0"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                                <TextBlock Text="of" 
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                                <TextBlock Text="{Binding TotalPages}" 
                                           VerticalAlignment="Center"
                                           Margin="10,0"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OnSurfaceBrush}"/>

                                <Button Content="&gt;" 
                                        Command="{Binding NextPageCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        MinWidth="40"
                                        Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL - Details Form -->
            <Border Grid.Column="1" Grid.Row="1" 
                    Background="{StaticResource SurfaceBrush}" 
                    Margin="10" CornerRadius="8" Padding="20"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- Form Fields -->
                        <RowDefinition Height="Auto"/> <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" 
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource OnSurfaceBrush}"
                               Margin="0,0,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                        <Setter Property="Text" Value="Create New Directive"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCreating}" Value="False">
                                        <Setter Property="Text" Value="Edit Directive"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Form Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Active Status -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Active" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource OnSurfaceBrush}"
                                           Margin="0,0,0,5"/>
                                <CheckBox IsChecked="{Binding EditItem.IsActive, UpdateSourceTrigger=PropertyChanged}"
                                          Content="Enable this BPM"
                                          VerticalAlignment="Center"
                                          FontSize="14"/>
                            </StackPanel>

                            <!-- Job Number -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Job\Part Number *" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource OnSurfaceBrush}"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding EditItem.Jobnum, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         FontSize="14"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         IsReadOnly="{Binding IsCreating, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>

                            <!-- OpCode -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="OpCode *" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource OnSurfaceBrush}"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding EditItem.OpCode, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         FontSize="14"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         IsReadOnly="{Binding IsCreating, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>

                            <!-- Operation Sequence -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Operation Sequence" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource OnSurfaceBrush}"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding EditItem.OperationSequence, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         FontSize="14"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         IsReadOnly="{Binding IsCreating, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>

                            <!-- Requestors -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Requestors *" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource OnSurfaceBrush}"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding EditItem.Requestors, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         FontSize="14"
                                         BorderBrush="{StaticResource BorderBrush}"/>
                                <TextBlock Text="Example: John Doe, Jane Smith" 
                                           FontSize="12" 
                                           Foreground="{StaticResource OnSurfaceTertiaryBrush}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Alert Message -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Alert Message *" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource OnSurfaceBrush}"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding EditItem.AlertMessage, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         FontSize="14"
                                         MinHeight="100"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderBrush="{StaticResource BorderBrush}"/>
                                <TextBlock Text="Describe the reason for the hold" 
                                           FontSize="12" 
                                           Foreground="{StaticResource OnSurfaceTertiaryBrush}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <TextBlock Text="* = Required field" 
                                       FontSize="12" 
                                       FontStyle="Italic"
                                       Foreground="{StaticResource OnSurfaceTertiaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Save" 
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="16,10"/>

                        <Button Grid.Column="2" 
                                Content="Cancel" 
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,10"/>

                        <Button Grid.Column="4" 
                                Content="Delete" 
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,10"
                                Visibility="{Binding IsCreating, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
