<UserControl x:Class="CompanyName.ProjectName.Hosts.WPF.ViewModels.MainMenu.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CompanyName.ProjectName.Hosts.WPF.ViewModels.MainMenu"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
                <TextBlock Text="Example Main Menu"
                          FontSize="32"
                          FontWeight="Bold"
                          Foreground="{StaticResource OnSurfaceBrush}"
                          Margin="20"/>

                <!-- Complete CMMOPS BPM Group -->
                <Border Background="{StaticResource SurfaceBrush}"
                       BorderBrush="{StaticResource BorderBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="24"
                       Margin="20">
                    <StackPanel>
                        <TextBlock Text="Constraint complete CMM operations BPM"
                                  FontSize="24"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource WarningBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <WrapPanel Orientation="Horizontal">
                            <!-- CMM 2PCS Button -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                                   Command="{Binding NavigateToCmm2PcsCommand}">
                                <StackPanel>
                                    <TextBlock Text="📋" 
                                             FontSize="48" 
                                             Margin="0,0,0,12"
                                             HorizontalAlignment="Left"/>
                                    <TextBlock Text="CMM 2PCS"
                                             FontSize="20"
                                             FontWeight="SemiBold"
                                             Foreground="{StaticResource OnSurfaceBrush}"
                                             Margin="0,0,0,8"/>
                                    <TextBlock Text="Cannot report if CMM QTY less than 2 Pieces"
                                             FontSize="14"
                                             Foreground="{StaticResource OnSurfaceSecondaryBrush}"
                                             TextWrapping="Wrap"
                                             MaxWidth="210"/>
                                </StackPanel>
                            </Button>

                            <!-- CMM 100 Button -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                                   Command="{Binding NavigateToCmm100Command}">
                                <StackPanel>
                                    <TextBlock Text="📋" 
                                             FontSize="48" 
                                             Margin="0,0,0,12"
                                             HorizontalAlignment="Left"/>
                                    <TextBlock Text="CMM 100"
                                             FontSize="20"
                                             FontWeight="SemiBold"
                                             Foreground="{StaticResource OnSurfaceBrush}"
                                             Margin="0,0,0,8"/>
                                    <TextBlock Text="Cannot report if CMM QTY is not equal 100%"
                                             FontSize="14"
                                             Foreground="{StaticResource OnSurfaceSecondaryBrush}"
                                             TextWrapping="Wrap"
                                             MaxWidth="210"/>
                                </StackPanel>
                            </Button>

                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Warning BPM Group -->
                <Border Background="{StaticResource SurfaceBrush}"
                       BorderBrush="{StaticResource BorderBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="24"
                       Margin="20">
                    <StackPanel>
                        <TextBlock Text="Warning BPM"
                                  FontSize="24"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource WarningBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <WrapPanel Orientation="Horizontal">
                            <!-- CNCOPS Button -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                                   Command="{Binding NavigateToCncOpsCommand}">
                                <StackPanel>
                                    <TextBlock Text="⚠️" 
                                             FontSize="48" 
                                             Margin="0,0,0,12"
                                             HorizontalAlignment="Left"/>
                                    <TextBlock Text="CNC OPS warning"
                                             FontSize="20"
                                             FontWeight="SemiBold"
                                             Foreground="{StaticResource OnSurfaceBrush}"
                                             Margin="0,0,0,8"/>
                                    <TextBlock Text="Show message when reporting CNCOPS"
                                             FontSize="14"
                                             Foreground="{StaticResource OnSurfaceSecondaryBrush}"
                                             TextWrapping="Wrap"
                                             MaxWidth="210"/>
                                </StackPanel>
                            </Button>

                            <!-- FULLCMM Button -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                                   Command="{Binding NavigateToFullCmmCommand}">
                                <StackPanel>
                                    <TextBlock Text="⚠️" 
                                             FontSize="48" 
                                             Margin="0,0,0,12"
                                             HorizontalAlignment="Left"/>
                                    <TextBlock Text="FULL CMM warning"
                                             FontSize="20"
                                             FontWeight="SemiBold"
                                             Foreground="{StaticResource OnSurfaceBrush}"
                                             Margin="0,0,0,8"/>
                                    <TextBlock Text="Show message when reporting CMM"
                                             FontSize="14"
                                             Foreground="{StaticResource OnSurfaceSecondaryBrush}"
                                             TextWrapping="Wrap"
                                             MaxWidth="210"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
    </Grid>
</UserControl>