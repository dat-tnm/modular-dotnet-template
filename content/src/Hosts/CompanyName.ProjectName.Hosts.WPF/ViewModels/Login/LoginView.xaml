<UserControl x:Class="CompanyName.ProjectName.Hosts.WPF.ViewModels.Login.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CompanyName.ProjectName.Hosts.WPF.ViewModels.Login"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <!-- Center Content -->
        <Border Background="{StaticResource SurfaceBrush}" 
                MaxWidth="400"
                MaxHeight="400"
                CornerRadius="12"
                Padding="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1">
            <StackPanel>
                <!-- Logo/Title Section -->
                <TextBlock Text="app-name" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                
                <TextBlock Text="app-description" 
                           FontSize="14" 
                           Foreground="{StaticResource OnSurfaceSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- Login Info Text -->
                <TextBlock Text="Please click the button below to authenticate" 
                           FontSize="14" 
                           Foreground="{StaticResource OnSurfaceBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Login Button -->
                <Button Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="20,12"
                        FontSize="16"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔐" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Login" FontSize="16"/>
                    </StackPanel>
                </Button>

                <!-- Footer -->
                <TextBlock Text="company-name" 
                           FontSize="12" 
                           Foreground="{StaticResource OnSurfaceTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>