{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "DbOptions": {
        "ConnectionString": "Server=localhost;Database=;Integrated Security=true;TrustServerCertificate=true;",
        "CommandTimeout": 30,
        "EnableRetry": true,
        "MaxRetryAttempts": 3
    },
    "ExternalDbOptions": {
        "ExternalPartDatabaseConnectionString": "Server=localhost;Database=;Integrated Security=true;TrustServerCertificate=true;",
        "PartCacheDurationMinutes": 30,
        "EnablePartCaching": true
    },
    "ApplicationSettings": {
        "ApplicationName": "appsetting_appname",
        "Version": "1.0.0",
        "Environment": "appsetting_environment"
    }
}
